{
  // Static site only: no Worker code. public/ is generated by Hugo from site/; wrangler dev and
  // deploy rebuild it first.
  "name": "alaska-rcv",
  "compatibility_date": "2026-10-01",
  "build": { "command": "hugo --source site --cleanDestinationDir --quiet" },
  "assets": { "directory": "./public", "not_found_handling": "404-page" },
  "routes": [{ "pattern": "alaska-rcv.dummthings.dev", "custom_domain": true }]
}
